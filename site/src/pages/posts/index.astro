---
import Row from '../../components/Row.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, postCard } from '../../lib/content';

const posts = (await getPosts()).map(postCard);

// Newest year first; the list is already newest first within it.
const byYear = new Map<string, typeof posts>();
for (const c of posts) {
  const year = c.date!.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(c);
}
---

<Base title="文章" description="依時間排列的所有文章。" path="/posts/" active="posts">
  <header class="index__head">
    <h1 class="doc__title">文章</h1>
  </header>

  {
    [...byYear].map(([year, cards]) => (
      <section class="section" aria-labelledby={`y-${year}`}>
        <header class="section__head">
          <h2 class="label" id={`y-${year}`}>{year}</h2>
          <span class="section__count label">{cards.length}</span>
        </header>
        <ul class="rows">{cards.map((c) => <Row card={c} />)}</ul>
      </section>
    ))
  }
  {posts.length === 0 && <p class="empty">還沒有文章。</p>}
</Base>
