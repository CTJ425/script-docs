{
  "name": "ivan-note-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ivan note — a personal tech blog (Astro, static) that publishes the scripts, tools and notes in this repo",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node scripts/check-contrast.mjs && node scripts/verify-content.mjs",
    "test:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run test:dist"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "pagefind": "^1.5.2",
    "prismjs": "^1.30.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "typescript": "^6.0.3"
  }
}
