{
  "name": "script-docs-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "README-driven documentation portal for script-docs (React + custom design system, deployed to GitHub Pages)",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "//typecheck": "manifest.json is generated and not committed, so it must exist before tsc can resolve it on a clean checkout.",
    "typecheck": "npm run sync && tsc --noEmit",
    "test": "node scripts/check-contrast.mjs && node scripts/smoke-test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^6.30.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.2",
    "vite": "^5.4.20"
  }
}
